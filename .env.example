# Postgres connection string, e.g. from Neon/Supabase/Vercel Postgres.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "disable" only for a local Postgres without SSL. Any other value
# (or unset) uses SSL, which every hosted provider above requires.
PGSSLMODE=require

# IANA timezone used to compute local calendar days (posted_date, day keys
# for medians/trends). This should be YOUR timezone, not the server's.
APP_TIMEZONE=America/Sao_Paulo

# Optional: cap the pg Pool size (default 5).
PGPOOL_MAX=5
