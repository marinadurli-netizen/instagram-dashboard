# Postgres connection string, e.g. from Neon/Supabase/Vercel Postgres.
# IMPORTANT: use the provider's transaction *pooler* connection string, not
# the direct one. Serverless functions are IPv4; a provider's direct
# connection is commonly IPv6-only (Neon's is), so the direct string
# connects fine from your own machine and from any local test, then fails
# only once deployed. On Neon this is the string with "-pooler" in the
# hostname (Dashboard > Connect > "Connection string", pooled toggle on).
DATABASE_URL=postgres://user:password@host-pooler:5432/dbname

# Set to "disable" only for a local Postgres without SSL. Any other value
# (or unset) uses SSL, which every hosted provider above requires.
PGSSLMODE=require

# IANA timezone used to compute local calendar days (posts.posted_at day
# keys, medians/trends windows). This should be YOUR timezone, not the
# server's.
APP_TIMEZONE=America/Sao_Paulo

# Optional: cap the pg Pool size (default 5).
PGPOOL_MAX=5

# Meta for Developers app credentials (developers.facebook.com > your app >
# Settings > Basic). Used for the Instagram OAuth connect flow.
META_APP_ID=
META_APP_SECRET=

# App Dashboard > Facebook Login for Business > Configurations. Bundles the
# permissions (pages_show_list, instagram_basic, instagram_manage_insights,
# etc.) that used to be passed as a `scope` param — set them on the
# Configuration itself in the Meta dashboard instead.
META_CONFIG_ID=

# Optional: Graph API version to call. Defaults to v21.0.
GRAPH_API_VERSION=v21.0

# Optional one-time bootstrap for the Instagram access token, as an
# alternative to connecting via /api/instagram/connect. Only used when the
# database doesn't already have a token stored (profile.instagram_access_token
# always wins once set) — sync persists any refreshed token to the database,
# since an env var can't be rewritten at runtime.
INSTAGRAM_ACCESS_TOKEN=

# Shared secret gating /api/instagram/connect so a random visitor can't
# start the OAuth flow and overwrite your profile row. Make up any
# long random string. This is a stopgap until the app has real password
# protection.
ADMIN_SECRET=

# Set on the Vercel project (Vercel sets this automatically for you if you
# add it as an env var — Vercel Cron then signs requests with it). Required
# for /api/cron/sync to accept requests.
CRON_SECRET=
